<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Authors>LocoNet2 contributors</Authors>
    <Description>Managed .NET port of the LocoNet2 protocol stack, communicating over TCP (LocoNet-over-TCP).</Description>
  </PropertyGroup>
</Project>
